  "latex": "P(A\\cup B)=P(A)+P(B)-P(AB),\\qquad P\\Big(\\bigcup_{i=1}^{n}A_i\\Big)=\\sum_i P(A_i)-\\sum_{i<j}P(A_iA_j)+\\cdots",
